# =============================================================================
# AI Code Review — Backend Environment Template
# Copy this file to .env and fill in your values:
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (macOS / Linux)
# =============================================================================

# development | demo | production
APP_ENV=demo

# Server
APP_HOST=0.0.0.0
APP_PORT=8001
# Auto-reload is disabled automatically when APP_ENV=demo or production
APP_RELOAD=false

# Required for full AI section analysis (get a key from https://platform.openai.com)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Optional
GITHUB_WEBHOOK_SECRET=

# Frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:3000

# Scan / chunk limits (raise carefully — larger = slower / costlier)
TEMP_CLONE_DIR=./temp_repos
MAX_FILES_TO_SCAN=50
MAX_FILE_SIZE_KB=100
CHUNK_MAX_CHARS=14000
CHUNK_MAX_FILES=8
